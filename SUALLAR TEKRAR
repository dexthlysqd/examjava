Balanced binary tree      2
public static boolean isBalanced(TreeNode root) {
    return balanced(root) != -1;
}
static int balanced(TreeNode n) {
    if (n == null) return 0;
    int left = balanced(n.left);
    if (left == -1) return -1;
    int right = balanced(n.right);
    if (right == -1) return -1;
    return Math.abs(left - right) > 1 ? -1 : 1 + Math.max(left, right);



 The depth of a specific node in a binary tree.        2
public static int getDepth(TreeNode root, int target) {
    if (root == null) return -1;
    if (root.val == target) return 0;
    int left = getDepth(root.left, target);
    int right = getDepth(root.right, target);
    return (left == -1 && right == -1) ? -1 : 1 + Math.max(left, right);
}





