Simulate Bacteria
static class Task3 {
    public int simulateBacteria(int m, int l, int t) {
        List<Integer> bacteria = new ArrayList<>();
        bacteria.add(0);
        for (int minute = 1; minute <= t; minute++) {
            List<Integer> next = new ArrayList<>();
            for (int age : bacteria) {
                int newAge = age + 1;
                if (newAge >= l) continue;
                if (newAge % m == 0) { next.add(0); next.add(0); }
                else next.add(newAge);
            }
            bacteria = next;
        }
        return bacteria.size();
    }
}

