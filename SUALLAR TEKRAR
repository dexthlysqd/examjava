Conversion of Roman Numerals to Integers, Score: 2

public static int romanToInt(String s) {
    int res = 0;
    for (int i = 0; i < s.length(); i++) {
        int v = val(s.charAt(i));
        if (i + 1 < s.length() && v < val(s.charAt(i + 1))) {
            res -= v;
        } else {
            res += v;
        }
    }
    return res;
}

private static int val(char c) {
    if (c == 'I') return 1;
    if (c == 'V') return 5;
    if (c == 'X') return 10;
    if (c == 'L') return 50;
    if (c == 'C') return 100;
    if (c == 'D') return 500;
    return 1000;
}

