static class ATMTask {

    public String calculateATM(int amount) {
        int[] notes = {100, 50, 20, 10, 5, 1};
        StringBuilder sb = new StringBuilder();
        for (int note : notes) {
            while (amount >= note) {
                if (sb.length() > 0) sb.append(",");
                sb.append(note);
                amount -= note;
            }
        }
        return sb.toString();
    }
