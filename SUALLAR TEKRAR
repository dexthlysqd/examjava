Run-Length Encoding
static class Task18 {
    public int compress(char[] chars) {
        int write = 0, i = 0;
        while (i < chars.length) {
            int j = i;
            while (j < chars.length && chars[j] == chars[i]) j++;
            chars[write++] = chars[i];
            if (j - i > 1) for (char c : String.valueOf(j - i).toCharArray()) chars[write++] = c;
            i = j;
        }
        return write;
    }
}

