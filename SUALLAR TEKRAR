-- 1. Create a table Users with a primary key user_id and a unique email.
-- What is the difference between them?

CREATE TABLE Users (
    user_id INT PRIMARY KEY,
    email VARCHAR(255) UNIQUE
);

/*
PRIMARY KEY = UNIQUE + NOT NULL, only one per table.
UNIQUE = duplicate values not allowed, NULL values allowed.
*/

-- 2. Build a report with one column labelled by type:
-- all customer names and all supplier names together.

SELECT customer_name AS name, 'Customer' AS type
FROM Customers
UNION
SELECT supplier_name AS name, 'Supplier' AS type
FROM Suppliers;

-- 3. Find employees who have the highest salary in the company.

SELECT *
FROM Employees
WHERE salary = (SELECT MAX(salary) FROM Employees);

-- 4. Find orders with an amount higher than the overall average order amount.

SELECT *
FROM Orders
WHERE amount > (
    SELECT AVG(amount)
    FROM Orders
);

-- 5. Show customers whose total order amount is above 1000,
-- sorted from highest to lowest.

SELECT customer_id,
       SUM(amount) AS total_order_amount
FROM Orders
GROUP BY customer_id
HAVING SUM(amount) > 1000
ORDER BY total_order_amount DESC;

-- 6. Count employees for each combination of department and city.

SELECT department,
       city,
       COUNT(*) AS employee_count
FROM Employees
GROUP BY department, city;

-- 7. Sort employees by department ascending,
-- then by salary descending within each department.

SELECT *
FROM Employees
ORDER BY department ASC, salary DESC;

-- 8. Select employees who are NOT (in Baku or earning less than 1000).

SELECT *
FROM Employees
WHERE NOT (city = 'Baku' OR salary < 1000);

-- 9. Copy all employees from Baku into the table Employees_Archive
-- (same structure).

INSERT INTO Employees_Archive
SELECT *
FROM Employees
WHERE city = 'Baku';

-- 10. Delete duplicate employees (same first_name and last_name),
-- keeping the one with the smallest emp_id.

DELETE e1
FROM Employees e1
JOIN Employees e2
ON e1.first_name = e2.first_name
AND e1.last_name = e2.last_name
AND e1.emp_id > e2.emp_id

-- 11. Set the salary to the company average for all employees whose salary is NULL.
 
UPDATE Employees
SET salary = (SELECT AVG(salary) FROM Employees)
WHERE salary IS NULL;
 
-- 12. Find the average of the department salary totals (subquery in FROM).
 
SELECT AVG(dept_total) AS avg_department_salary
FROM (
SELECT SUM(salary) AS dept_total
FROM Employees
GROUP BY department
) t;
 
-- 13. Find customers who have never placed an order.
 
SELECT *
FROM Customers c
WHERE NOT EXISTS (
SELECT 1
FROM Orders o
WHERE o.customer_id = c.customer_id
);
 
-- 14. Find the second highest salary.
 
SELECT MAX(salary)
FROM Employees
WHERE salary < (
SELECT MAX(salary)
FROM Employees
);
 
-- 15. Find employees who earn more than the average salary of their own department (correlated subquery).
 
SELECT *
FROM Employees e
WHERE salary > (
SELECT AVG(salary)
FROM Employees
WHERE department = e.department
);
 
-- 16. Find duplicate last names in Employees.
 
SELECT last_name, COUNT(*) AS cnt
FROM Employees
GROUP BY last_name
HAVING COUNT(*) > 1;
 
-- 17. Get all cities from Customers and Suppliers (no duplicates), sorted alphabetically.
 
SELECT city
FROM Customers
UNION
SELECT city
FROM Suppliers
ORDER BY city;
 
-- 18. Show the average salary per department only for employees hired after 2020
-- and only departments with an average above 3000.
 
SELECT department,
AVG(salary) AS avg_salary
FROM Employees
WHERE hire_date > '2020-12-31'
GROUP BY department
HAVING AVG(salary) > 3000;
 
-- 19. Create Orders with a foreign key that automatically deletes orders
-- when the customer is deleted.
 
CREATE TABLE Orders (
order_id INT PRIMARY KEY,
customer_id INT,
FOREIGN KEY (customer_id)
REFERENCES Customers(customer_id)
ON DELETE CASCADE
);
 
-- 20. Create a table OrderItems where the primary key is a combination
-- of order_id and prod_id.
 
CREATE TABLE OrderItems (
order_id INT,
prod_id INT,
quantity INT,
PRIMARY KEY (order_id, prod_id)
);

